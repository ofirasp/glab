{
  "manifest_version": 3,
  "name": "Guitar Practice Lab \u00b7 Save lesson",
  "version": "1.0.0",
  "description": "Remembers the last lesson tab so the local Practice return screen can save its link.",
  "key": "",
  "permissions": [
    "tabs",
    "storage"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "externally_connectable": {
    "matches": [
      "http://127.0.0.1/*",
      "http://localhost/*"
    ]
  },
  "minimum_chrome_version": "102"
}