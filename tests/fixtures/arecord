#!/usr/bin/env python3
# Synthetic ALSA stand-in for integration tests; never installed on the Pi.
import sys,time,math,struct
if '-L' in sys.argv:print('default\n    Test microphone\nplughw:CARD=USB,DEV=0\n    USB test microphone');sys.exit()
device=sys.argv[sys.argv.index('-D')+1]
if device=='test-failure':print('Test microphone disconnected',file=sys.stderr);sys.exit(1)
rate=16000;chunk=2048;at=0;started=time.monotonic()
try:
 while True:
  values=[]
  for i in range(chunk):
   t=(at+i)/rate
   notes=[48,52,55,60,64] if device=='held' or int(t/.9)%2==0 else [43,47,50,55,59,67]
   value=0
   for midi in notes:
    for h in range(1,5):value+=.025*math.sin(2*math.pi*440*2**((midi-69)/12)*h*t)/(h**1.25)
   values.append(int(max(-.95,min(.95,value))*32767))
  sys.stdout.buffer.write(struct.pack('<'+'h'*chunk,*values));sys.stdout.buffer.flush();at+=chunk
  time.sleep(max(0,started+at/rate-time.monotonic()))
except BrokenPipeError:pass
